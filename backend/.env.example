# Server port
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/Vistora

# Secret used to sign JWTs
JWT_SECRET=replace_with_a_long_random_secret

# Environment: development | production | test
NODE_ENV=development

# Frontend URL allowed to access the API
FRONTEND_URL=http://localhost:5173

# Razorpay API credentials
# Use Test Mode credentials for development
RAZORPAY_KEY_ID=replace_with_razorpay_test_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_key_secret

# Razorpay webhook signing secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

